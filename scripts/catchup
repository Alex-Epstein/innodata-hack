#!/usr/bin/env bash
# Everything that happened recently: decisions, live log, commits on main, open issues, newest status lines.
REPO=Alex-Epstein/innodata-hack
cd "$(dirname "$0")/.." || exit 0
echo "== Decisions =="; tail -n 8 docs/DECISIONS.md 2>/dev/null
echo; echo "== Live log (latest 20, issue #1) =="
gh api "repos/$REPO/issues/1/comments?per_page=100" --jq '.[-20:][] | .body' 2>/dev/null || echo "(gh not signed in: run gh auth login)"
echo; echo "== main (latest 10) =="
git fetch -q origin 2>/dev/null; git log --oneline -10 origin/main 2>/dev/null
echo; echo "== Open issues =="
gh issue list --repo "$REPO" --state open --limit 20 2>/dev/null
echo; echo "== Newest status lines =="
ls -1 status 2>/dev/null | grep -v '^\.' | sort | tail -8 | while read -r f; do printf '%s: ' "$f"; cat "status/$f"; done
exit 0
