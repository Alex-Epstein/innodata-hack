#!/usr/bin/env bash
# Golden path check: run before every merge. Offline: the models are mocked (MOCK=1), nothing is spent.
# build a fresh task -> every validate/ check -> both (mock) models via eval/ -> results row; then the tests.
set -euo pipefail
cd "$(dirname "$0")/.."
out="$(mktemp -d "${TMPDIR:-/tmp}/innodata-check.XXXXXX")"
trap 'rm -rf "$out"' EXIT
MOCK=1 uv run python -m factory fresh --seed 0 --family example --out "$out/fresh"
test -s "$out/fresh/results/responses.csv"
MOCK=1 uv run python -m unittest discover -s tests -t .
MOCK=1 uv run python -m unittest eval.test_eval
uv run python -m factory list >/dev/null
echo "scripts/check: golden path OK"
