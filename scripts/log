#!/usr/bin/env bash
# Post one line to the live log (issue #1). Usage: scripts/log "what happened"
# Set LOG_WHO to say who is posting (e.g. LOG_WHO="Alex's agent"); defaults to your git name.
set -euo pipefail
[ $# -ge 1 ] || { echo 'usage: scripts/log "message"' >&2; exit 1; }
who="${LOG_WHO:-$(git config user.name || whoami)}"
gh issue comment 1 --repo Alex-Epstein/innodata-hack --body "**${who}** · $(date +%H:%M) · $*" >/dev/null
echo "logged"
# Surface open directives every time an agent logs, so they reach agents mid-task.
bash "$(dirname "$0")/directives-check"
