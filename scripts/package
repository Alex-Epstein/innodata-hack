#!/usr/bin/env python3
"""Build the submission ZIP and run the organizers' format checker on it.

    scripts/package OurTeam            -> OurTeam_Track2.zip at the repo root, then the checker (must show 0 FAIL)
    scripts/package --fill-readme      -> rewrites the README's "Final results" and "Hand check" blocks from
                                          tasks/final, results/final and results/human/hand_check.md (no number
                                          is typed by hand); run it before the team-name form
    scripts/package --dummy            -> proves the layout before real tasks exist: copies the repo to a temp
                                          folder, adds 10 placeholder tasks and a MOCK evaluation (no model is
                                          called, nothing is written to the repo), zips it and runs the checker

Only files tracked by git go in, so .env, cache/, .venv/ and scratch files can never be included.
Standard library only.
"""
import argparse
import csv
import json
import os
import shutil
import subprocess
import sys
import tempfile
import zipfile
from pathlib import Path

ROOT = Path(__file__).resolve().parent.parent
CHECKER = ROOT / "tools" / "track2-format-check" / "check_submission.py"
LEAVE_OUT = (".claude/", ".cursor/", ".github/")          # agent and GitHub tooling, not part of the submission
PNG_1PX = bytes.fromhex("89504e470d0a1a0a0000000d49484452000000010000000108060000001f15c489"
                        "0000000d49444154789c6360000002000001e221bc330000000049454e44ae426082")


def tracked_files(root: Path) -> list[str]:
    out = subprocess.run(["git", "ls-files", "-z"], cwd=root, capture_output=True, text=True, check=True).stdout
    files = [f for f in out.split("\0") if f and not f.startswith(LEAVE_OUT)]
    return [f for f in files if (root / f).is_file() and not (root / f).is_symlink()]


def warn_untracked(root: Path) -> None:
    out = subprocess.run(["git", "status", "--porcelain", "--", "tasks", "results", "gen", "validate", "eval"],
                         cwd=root, capture_output=True, text=True).stdout.strip()
    if out:
        print("WARNING: uncommitted or untracked files below are NOT in the ZIP unless tracked by git "
              "(modified tracked files are zipped as they are on disk):\n" + out, file=sys.stderr)


def make_zip(src: Path, files: list[str], zip_path: Path) -> None:
    with zipfile.ZipFile(zip_path, "w", zipfile.ZIP_DEFLATED) as z:
        for f in sorted(files):
            z.write(src / f, f)
    print(f"{zip_path}: {len(files)} files, {zip_path.stat().st_size / 1048576:.2f} MB")


def run_checker(zip_path: Path) -> int:
    return subprocess.run([sys.executable, str(CHECKER), str(zip_path)]).returncode


def dummy_submission(work: Path) -> list[str]:
    """Copy the tracked repo into `work` and fill in placeholder tasks, results and README notes."""
    files = tracked_files(ROOT)
    for f in files:
        (work / f).parent.mkdir(parents=True, exist_ok=True)
        shutil.copy2(ROOT / f, work / f)

    tasks = work / "tasks" / "final"
    shutil.rmtree(tasks, ignore_errors=True)
    (tasks / "images").mkdir(parents=True)
    (tasks / "data").mkdir()
    kinds = [("integer", 7, {}), ("number", 12.5, {"tolerance_abs": 0.1}), ("label", "Wed 10:15", {}),
             ("multiple_choice", "B", {"options": ["one", "two", "three"]}),
             ("sequence", ["L3", "L4"], {"ordered": False})]
    ids = []
    with open(tasks / "tasks.jsonl", "w") as out:
        for i in range(10):
            kind, answer, extra = kinds[i % len(kinds)]
            tid = f"dummy-{i:06d}"
            ids.append(tid)
            (tasks / "images" / f"{tid}.png").write_bytes(PNG_1PX)
            (tasks / "data" / f"{tid}.json").write_text(json.dumps(
                {"task_id": tid, "family": "dummy", "seed": i, "generator_version": "dummy-0", "params": {},
                 "data": {}, "references": ["placeholder"]}))
            out.write(json.dumps({
                "task_id": tid, "image": f"images/{tid}.png", "answer": answer, "answer_type": kind,
                "question": "Placeholder question. Give the value to within ±0.1.", "seed": i,
                "generator_version": "dummy-0", "question_type": f"dummy.{kind}", "family": "dummy",
                "difficulty": 1, "data": f"data/{tid}.json", "checks": {"schema": True},
                "references": ["placeholder"], **extra}) + "\n")

    results = work / "results" / "final"
    shutil.rmtree(results, ignore_errors=True)
    env = {**os.environ, "MOCK": "1", "EVAL_CACHE_DIR": str(work / "cache")}
    subprocess.run([sys.executable, "-m", "eval.run", "--tasks", "tasks/final", "--out", "results/final"],
                   cwd=work, env=env, check=True, stdout=subprocess.DEVNULL)
    shutil.rmtree(work / "cache", ignore_errors=True)

    if not any(p.suffix == ".py" for p in (work / "validate").rglob("*")):
        (work / "validate" / "placeholder.py").write_text("# placeholder so the layout check has code to find\n")

    readme = (work / "README.md").read_text()
    readme = readme.replace("## Hand check\n", "## Hand check\n" + "".join(
        f"- `{t}`: placeholder note.\n" for t in ids), 1)
    readme = readme.replace("## Pilot results\n", "## Pilot results\nPlaceholder: pilot 1 scored 0 of 10; the "
                            "generator was changed to add harder levels.\n", 1)
    (work / "README.md").write_text(readme)
    return sorted(str(p.relative_to(work)) for p in work.rglob("*") if p.is_file() and "__pycache__" not in p.parts)


# ---------------------------------------------------------------------------------------------- README blocks
SHORT = {"anthropic/claude-haiku-5.5": "Haiku", "openai/gpt-6-luna": "Luna"}


def _block(text: str, name: str, body: str) -> str:
    a, b = f"<!-- {name}:start -->", f"<!-- {name}:end -->"
    if a not in text or b not in text:
        raise SystemExit(f"README.md has no {a} ... {b} block")
    return text[:text.index(a) + len(a)] + "\n" + body.strip() + "\n" + text[text.index(b):]


def final_results_block(tasks_dir: Path, results_dir: Path) -> str:
    """The reported scores, read from tasks.jsonl, validation_report.json, responses.csv and summary.json."""
    csv.field_size_limit(10 ** 9)
    tasks = [json.loads(l) for l in (tasks_dir / "tasks.jsonl").read_text(encoding="utf-8").splitlines() if l.strip()]
    rows = list(csv.DictReader(open(results_dir / "responses.csv", encoding="utf-8")))
    models = [m for m in SHORT if any(r["model"] == m for r in rows)]
    got = {(r["model"], r["task_id"]): r for r in rows}
    lines = ["| Task | Mission | Reference answer | " + " | ".join(SHORT[m] for m in models) + " |",
             "|---|---|---|" + "---|" * len(models)]
    for t in tasks:
        cells = []
        for m in models:
            r = got.get((m, t["task_id"]))
            cells.append("no row" if r is None else f"{r['parsed'] or '(none)'} {'✓' if r['correct'] == '1' else '✗'}")
        answer = ", ".join(map(str, t["answer"])) if isinstance(t["answer"], list) else t["answer"]
        lines.append(f"| `{t['task_id']}` | {t['question_type'].split('.', 1)[1]} | {answer} | " + " | ".join(cells) + " |")
    total = ["| **Total** | | |"]
    for m in models:
        mine = [r for r in rows if r["model"] == m]
        total.append(f" **{sum(r['correct'] == '1' for r in mine)}/{len(mine)}** |")
    lines.append("".join(total))
    out = ["\n".join(lines), ""]
    kinds = sorted({t["question_type"] for t in tasks})
    per = []
    for k in kinds:
        ids = {t["task_id"] for t in tasks if t["question_type"] == k}
        per.append(k.split(".", 1)[1] + " " + ", ".join(
            f"{SHORT[m]} {sum(r['correct'] == '1' for r in rows if r['model'] == m and r['task_id'] in ids)}/{len(ids)}"
            for m in models))
    out.append("By mission: " + "; ".join(per) + ".")
    stop = sum(r["finish_reason"] == "stop" and not r["error"] for r in rows)
    facts = [f"{stop} of {len(rows)} replies are complete (`finish_reason` stop, no error)"]
    summary = results_dir / "summary.json"
    if summary.exists():
        cost = json.loads(summary.read_text(encoding="utf-8")).get("totals", {}).get("cost_usd_all_calls")
        if cost is not None:
            facts.append(f"the run cost ${cost:.4f}")
    report = tasks_dir / "validation_report.json"
    if report.exists():
        rep = json.loads(report.read_text(encoding="utf-8"))
        if "all_passed" in rep and "checked" in rep:
            facts.append(f"{rep['all_passed']} of {rep['checked']} tasks pass every automatic check")
    versions = sorted({t["generator_version"] for t in tasks})
    facts.append("generator " + ", ".join(f"`{v}`" for v in versions) + f", seeds {', '.join(str(t['seed']) for t in tasks)}")
    out.append("Facts: " + "; ".join(facts) + ".")
    return "\n".join(out)


def hand_check_block(tasks_dir: Path, notes: Path) -> str:
    """The person's notes, verbatim, plus a line for any reported task the notes do not mention."""
    ids = [json.loads(l)["task_id"] for l in (tasks_dir / "tasks.jsonl").read_text(encoding="utf-8").splitlines() if l.strip()]
    if not notes.exists():
        return "\n".join(f"- `{t}`: hand check pending." for t in ids)
    text = notes.read_text(encoding="utf-8").strip()
    body = "\n".join(l for l in text.splitlines() if not l.startswith("# "))
    missing = [t for t in ids if t not in text]
    return (body.strip() + "\n" + "\n".join(f"- `{t}`: not covered by the hand-check notes." for t in missing)).strip()


def fill_readme(tasks_dir: Path, results_dir: Path, notes: Path) -> int:
    readme = ROOT / "README.md"
    text = readme.read_text(encoding="utf-8")
    text = _block(text, "final-results", final_results_block(tasks_dir, results_dir))
    text = _block(text, "hand-check", hand_check_block(tasks_dir, notes))
    readme.write_text(text, encoding="utf-8")
    print(f"README.md: final results from {results_dir}, hand check from {notes if notes.exists() else '(pending)'}")
    return 0


def main() -> int:
    ap = argparse.ArgumentParser(description=__doc__.split("\n\n")[0])
    ap.add_argument("team", nargs="?", help="team name: letters, digits, - and _ (the ZIP is <team>_Track2.zip)")
    ap.add_argument("--dummy", action="store_true", help="check the layout with placeholder tasks; repo untouched")
    ap.add_argument("--fill-readme", action="store_true", help="rewrite the README's result and hand-check blocks")
    ap.add_argument("--tasks", default="tasks/final")
    ap.add_argument("--results", default="results/final")
    ap.add_argument("--hand-check", default="results/human/hand_check.md")
    a = ap.parse_args()
    if a.fill_readme:
        return fill_readme(ROOT / a.tasks, ROOT / a.results, ROOT / a.hand_check)
    if a.dummy:
        with tempfile.TemporaryDirectory() as d:
            work = Path(d) / "repo"
            work.mkdir()
            files = dummy_submission(work)
            zip_path = Path(d) / "Dummy_Track2.zip"
            make_zip(work, files, zip_path)
            return run_checker(zip_path)
    if not a.team:
        ap.error("give the team name, e.g. scripts/package OurTeam  (or --dummy)")
    warn_untracked(ROOT)
    zip_path = ROOT / f"{a.team}_Track2.zip"
    zip_path.unlink(missing_ok=True)
    make_zip(ROOT, tracked_files(ROOT), zip_path)
    return run_checker(zip_path)


if __name__ == "__main__":
    sys.exit(main())
